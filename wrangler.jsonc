{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app225",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6b873614-25ce-400a-a8d1-3e0282df3229","database_name": "web-app225" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fdbb322cf12e4541bb92dc362ac44e82" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
